# ════════════════════════════════════════════════════
#  AI Content Pipeline — Environment Config
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to GitHub.
# ════════════════════════════════════════════════════

# ── Gemini API (free tier) ───────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Telegram Bot ─────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot
# 2. Copy the token below
# 3. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your CHAT_ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Paths (Windows — use forward slashes) ────────
INPUT_FOLDER=./input
OUTPUT_RECAP_FOLDER=./outputs/recap
OUTPUT_ANIMALS_FOLDER=./outputs/animals
MODELS_FOLDER=./models
MUSIC_FOLDER=./music
LOGS_FOLDER=./logs

# ── Whisper Settings ─────────────────────────────
# Options: tiny, base, small, medium, large-v2, large-v3
# medium = best balance for RTX 3050 4GB VRAM
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# ── Stable Diffusion Settings ────────────────────
# SD 1.5 is the default (fits 4GB VRAM)
# Change to SDXL only for special days (slower)
SD_MODEL=runwayml/stable-diffusion-v1-5
SD_DEVICE=cuda
SD_INFERENCE_STEPS=30
SD_GUIDANCE_SCALE=7.5
SD_IMAGE_WIDTH=576
SD_IMAGE_HEIGHT=1024
SD_FRAMES_PER_VIDEO=10
# Set to true on SDXL days — uses CPU offload
SD_LOW_VRAM_MODE=false

# ── Animal Module Schedule ───────────────────────
# Runs at 10:15 AM Malaysia time (UTC+8) on startup
# 10 min buffer after typical 10:00 AM boot
ANIMAL_CRON_HOUR=10
ANIMAL_CRON_MINUTE=15
ANIMAL_CRON_TIMEZONE=Asia/Kuala_Lumpur

# ── Video Output Settings ────────────────────────
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_BITRATE=4000k
ANIMAL_VIDEO_DURATION=20

# ── Gemini Model ─────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash

# ── Language Settings ────────────────────────────
# EN voice: edge-tts natural voice
EN_TTS_VOICE=en-US-JennyNeural
# MY voice: gTTS language code
MY_TTS_LANG=my
